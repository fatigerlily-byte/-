<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OjisanWatch" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/ojisan_accent</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="actionBarStyle">@style/OjisanActionBar</item>
    </style>

    <style name="OjisanActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="background">@color/background_dark</item>
        <item name="titleTextStyle">@style/OjisanActionBarTitle</item>
    </style>

    <style name="OjisanActionBarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/white</item>
    </style>
</resources>
